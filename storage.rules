rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && profile().role == 'admin';
    }
    function isApprovedOwner(sellerId) {
      return signedIn() && request.auth.uid == sellerId
        && profile().role == 'seller' && profile().approved == true;
    }

    match /products/{sellerId}/{fileName} {
      allow read: if true;
      allow create: if request.resource.size <= 300 * 1024
        && request.resource.contentType == 'image/jpeg'
        && (isAdmin() || isApprovedOwner(sellerId));
    }
  }
}
