rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return verified() && me().role == 'admin'; }

    match /users/{uid} {
      allow read: if verified() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['buyer', 'seller']
        && request.resource.data.approved == (request.resource.data.role == 'buyer');
      allow update: if isAdmin() || (verified() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.approved == resource.data.approved);
    }
    match /verifications/{uid} {
      allow read: if verified() && (request.auth.uid == uid || isAdmin());
      allow create: if verified() && request.auth.uid == uid && me().role == 'seller'
        && request.resource.data.sellerId == request.auth.uid && request.resource.data.status == 'Pending'
        && request.resource.data.docUrl is string && request.resource.data.docUrl.size() <= 900000;
      allow update: if isAdmin() || (verified() && request.auth.uid == uid && me().role == 'seller'
        && resource.data.status == 'Rejected' && request.resource.data.status == 'Pending'
        && request.resource.data.docUrl is string && request.resource.data.docUrl.size() <= 900000);
    }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /products/{id} {
      allow read: if true;
      allow create: if verified() && me().role == 'seller' && me().approved == true
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 900000;
      allow update: if verified() && (resource.data.sellerId == request.auth.uid || isAdmin())
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 900000;
      allow delete: if verified() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }
    match /orders/{id} {
      allow create: if verified() && me().role == 'buyer' && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.qty is int
        && request.resource.data.qty > 0
        && request.resource.data.buyerPhone is string
        && request.resource.data.buyerPhone.size() > 0
        && request.resource.data.buyerPhone.size() <= 32
        && request.resource.data.buyerAddress is string
        && request.resource.data.buyerAddress.size() > 0
        && request.resource.data.buyerAddress.size() <= 500;
      allow read: if verified() && (resource.data.buyerId == request.auth.uid
        || resource.data.sellerId == request.auth.uid || isAdmin());
      allow update: if verified() && (resource.data.sellerId == request.auth.uid || isAdmin()
        || (resource.data.buyerId == request.auth.uid && request.resource.data.status == 'Cancelled'));
    }
  }
}
